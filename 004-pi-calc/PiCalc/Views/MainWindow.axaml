<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PiCalc.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:PiCalc.Controls"
        xmlns:util="clr-namespace:PiCalc.Util"
        mc:Ignorable="d"
        d:DesignWidth="600"
        d:DesignHeight="400"
        Width="600"
        Height="400"
        CanResize="False"
        x:Class="PiCalc.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="PiCalc">
    <Design.DataContext>
        <vm:DesignMainWindowViewModel />
    </Design.DataContext>
    <Grid ColumnDefinitions="*,*"
          ColumnSpacing="10"
          Margin="5">
        <Grid.Resources>
            <util:IntToDoubleConverter x:Key="IntToDoubleConverter" />
        </Grid.Resources>

        <StackPanel Grid.Column="0"
                    Spacing="12">
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding ExperimentsLabel}"
                           FontWeight="SemiBold" />
                <TextBox Text="{Binding ExperimentsToRun}"
                         IsEnabled="{Binding IsRunning, Converter={x:Static BoolConverters.Not}}" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="{Binding ThreadsLabel}"
                           FontWeight="SemiBold" />
                <Slider Minimum="{Binding MinThreads, Converter={StaticResource IntToDoubleConverter}}"
                        Maximum="{Binding MaxThreads, Converter={StaticResource IntToDoubleConverter}}"
                        Value="{Binding Threads, Converter={StaticResource IntToDoubleConverter}}"
                        IsEnabled="{Binding IsRunning, Converter={x:Static BoolConverters.Not}}" />
            </StackPanel>

            <StackPanel Spacing="2">
                <TextBlock Text="Report Progress"
                           FontWeight="SemiBold" />
                <ToggleSwitch IsChecked="{Binding IsProgressReportingEnabled}"
                              OnContent="On"
                              OffContent="Off"
                              IsEnabled="{Binding IsRunning, Converter={x:Static BoolConverters.Not}}" />
            </StackPanel>

            <StackPanel Spacing="2">
                <TextBlock Text="Render Experiments"
                           FontWeight="SemiBold" />
                <ToggleSwitch IsChecked="{Binding IsResultRenderingEnabled}"
                              OnContent="On"
                              OffContent="Off"
                              IsEnabled="{Binding IsRunning, Converter={x:Static BoolConverters.Not}}" />
            </StackPanel>

            <StackPanel Spacing="2">
                <TextBlock Text="Vectorize"
                           FontWeight="SemiBold" />
                <ToggleSwitch IsChecked="{Binding IsVectorized}"
                              OnContent="On"
                              OffContent="Off"
                              IsEnabled="{Binding IsRunning, Converter={x:Static BoolConverters.Not}}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Spacing="10"
                        Margin="0,10,0,0">
                <Button Content="Start"
                        Command="{Binding StartCalculationCommand}"
                        Width="70"
                        HorizontalContentAlignment="Center" />
                <Button Content="Stop"
                        Command="{Binding StopCalculationCommand}"
                        Width="70"
                        HorizontalContentAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Column="1"
              RowDefinitions="*,Auto,Auto"
              RowSpacing="10">
            <controls:ExperimentRenderer Grid.Row="0"
                                         DataContext="{Binding ExperimentRendererViewModel}"
                                         IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsResultRenderingEnabled, FallbackValue={x:False}}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center" />

            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Center"
                        Spacing="2">
                <TextBlock Text="Result"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           FontSize="16" />
                <TextBlock Text="{Binding ResultValue}"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           FontSize="16" />
                <TextBlock Text="{Binding ElapsedTimeText, StringFormat='({0})'}"
                           HorizontalAlignment="Center"
                           Foreground="Gray" />
            </StackPanel>

            <ProgressBar Grid.Row="2"
                         Minimum="0"
                         Maximum="1"
                         Value="{Binding ProgressValue}"
                         ShowProgressText="True"
                         Height="28"
                         HorizontalAlignment="Stretch" />
        </Grid>
    </Grid>
</Window>
