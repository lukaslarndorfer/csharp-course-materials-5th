<util:ScopedWindow xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:util="clr-namespace:PuppyAdoption.Client.Util"
                   xmlns:viewModels="clr-namespace:PuppyAdoption.Client.ViewModels"
                   mc:Ignorable="d" d:DesignWidth="350" d:DesignHeight="130"
                   x:Class="PuppyAdoption.Client.Views.Dialogs.DeletePuppyDialogWindow"
                   x:DataType="viewModels:DeletePuppyDialogWindowViewModel"
                   Title="Delete Puppy">
    <Design.DataContext>
        <viewModels:DesignDeletePuppyDialogWindowViewModel />
    </Design.DataContext>
    <Grid RowDefinitions="*,*,*" Margin="5">
        <TextBlock Grid.Row="0" Text="{Binding PuppyDeletionConfirmationText}" HorizontalAlignment="Center"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0 5 0 0">
            <Button Command="{Binding CancelCommand}">Cancel</Button>
            <Button Classes="danger" Command="{Binding DeleteCommand}">Delete</Button>
        </StackPanel>
        <ProgressBar Grid.Row="2" IsIndeterminate="True" IsVisible="{Binding Processing}" />
    </Grid>
</util:ScopedWindow>