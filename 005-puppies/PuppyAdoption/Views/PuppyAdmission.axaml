<util:ScopedControl xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:util="clr-namespace:PuppyAdoption.Util"
                    xmlns:vm="clr-namespace:PuppyAdoption.ViewModels"
                    mc:Ignorable="d" d:DesignWidth="1500" d:DesignHeight="788"
                    x:DataType="vm:PuppyAdmissionViewModel"
                    x:Class="PuppyAdoption.Views.PuppyAdmission">
    <UserControl.Resources>
        <util:LocalDateDateTimeOffsetConverter x:Key="LocalDateConverter" />
    </UserControl.Resources>
    <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
        <StackPanel Grid.Column="0" Orientation="Vertical" Margin="10" Spacing="20">
            <TextBlock>Name</TextBlock>
            <TextBox Text="{Binding PuppyName}" />
            <TextBlock>Breed</TextBlock>
            <TextBox Text="{Binding Breed}" />
            <DatePicker SelectedDate="{Binding DateOfBirth, Converter={StaticResource LocalDateConverter}}" />


            <ProgressBar  Orientation="Horizontal" IsIndeterminate="True" Margin="0,20, 0, 0"
                         IsVisible="{Binding Processing}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="10" Margin="10">
            <Border MaxWidth="{Binding MaxImageSize}" MaxHeight="{Binding MaxImageSize}">
                <Image Source="{Binding ImagePreview}" Stretch="Uniform" />
            </Border>
            <Button Content="Pick Image" Click="HandlePickImage" HorizontalAlignment="Center" Margin="0,20" />
        </StackPanel>
    </Grid>
</util:ScopedControl>