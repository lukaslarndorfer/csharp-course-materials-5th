<util:ScopedControl xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:util="clr-namespace:PuppyAdoption.Util"
                    xmlns:vm="clr-namespace:PuppyAdoption.ViewModels"
                    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                    x:DataType="vm:PuppyListViewModel"
                    x:Class="PuppyAdoption.Views.PuppyList">
    <Control.Styles>
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    </Control.Styles>
    <Design.DataContext>
        <vm:DesignPuppyListViewModel />
    </Design.DataContext>
    <DockPanel Margin="5" LastChildFill="True">
        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" HorizontalAlignment="Stretch"
                     IsVisible="{Binding Loading}" />
        <TextBlock FontStyle="Italic" IsVisible="{Binding ShowEmptyHint}">No puppies yet</TextBlock>
        <DataGrid ItemsSource="{Binding Puppies}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  GridLinesVisibility="All" BorderThickness="1"
                  BorderBrush="Gray" SelectedItem="{Binding SelectedPuppy}"
                  IsVisible="{Binding HasEntries}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" IsReadOnly="True" />
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" IsReadOnly="True" />
                <DataGridCheckBoxColumn Header="Adopted" Binding="{Binding Adopted}" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</util:ScopedControl>